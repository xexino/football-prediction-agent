# Football Intelligence Lab — environment configuration
# Copy to .env and fill in what you have. Every key is OPTIONAL: the system runs on
# free, key-less sources (football-data.co.uk, TheSportsDB public test key, GitHub datasets).
# Never commit your real .env.

# football-data.org (free tier: 12 competitions incl. Champions League, 10 req/min)
# Register at https://www.football-data.org/client/register
FOOTBALL_DATA_ORG_KEY=

# The Odds API (free tier: 500 credits/month). https://the-odds-api.com
ODDS_API_KEY=

# API-Football (free tier: 100 req/day, broad coverage incl. African leagues, injuries, lineups)
# https://www.api-football.com
API_FOOTBALL_KEY=

# TheSportsDB — "123" is the public free test key (heavily rate/size limited).
THESPORTSDB_KEY=123

# Storage
FIL_DB_PATH=data/fil.db
FIL_BACKUP_DIR=data/backups

# Server
FIL_HOST=0.0.0.0
FIL_PORT=8000
# Protects POST /api/admin/* endpoints. Leave empty to disable admin endpoints entirely.
FIL_ADMIN_TOKEN=

# Scheduler (set to 0 to disable the in-process scheduler, e.g. when using cron/GitHub Actions)
FIL_SCHEDULER=1
